# ══════════════════════════════════════════════════════════════
# Frontend (Vite) — Reverb WebSocket Configuration
# ══════════════════════════════════════════════════════════════
#
# These variables configure the Laravel Echo + Reverb WebSocket client.
#
# VITE_REVERB_HOST — The HOSTNAME (not a full URL) where Reverb is running.
#   - Correct:  backend.swiftflitz.test
#   - Correct:  localhost
#   - WRONG:    http://backend.swiftflitz.test/api/v1   ← never use a URL here
#
# VITE_REVERB_PORT — The WebSocket port Reverb listens on (default: 8080).
#   - Must match REVERB_PORT in the backend .env.
#
# VITE_REVERB_SCHEME — "http" for local/dev, "https" for production.
#   - When scheme is "https", Echo will use WSS (encrypted WebSocket).
#
# VITE_REVERB_APP_KEY — Must match REVERB_APP_KEY in the backend .env.
# ══════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://backend.swiftflitz.test/api/v1
VITE_BASE_URL=http://backend.swiftflitz.test

# Reverb WebSocket — hostname only, no scheme or path
VITE_REVERB_APP_KEY=your-app-key
VITE_REVERB_HOST=backend.swiftflitz.test
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
