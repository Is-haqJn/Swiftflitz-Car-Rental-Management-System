{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "types": [
            "vite/client",
            "vitest/globals",
            "@testing-library/jest-dom",
            "vite-plugin-pwa/client"
        ],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,

        /* Path Mapping */
        //"baseUrl": "./",
        "paths": {
            "@/*": ["./src/*"],
            "@admin/*": ["./src/admin/*"],
            "@adminComponents/*": ["./src/admin/components/*"],
            "@adminUtils/*": ["./src/admin/utils/*"],
            "@adminServices/*": ["./src/admin/services/*"],
            "@adminAssets/*": ["./src/admin/assets/*"],
            "@adminHooks/*": ["./src/admin/hooks/*"],
            "@adminStyles/*": ["./src/admin/styles/*"],
            "@adminConfig/*": ["./src/admin/config/*"],
            "@adminTypes/*": ["./src/admin/types/*"],
            "@adminContext/*": ["./src/admin/context/*"],
            "@adminRoutes/*": ["./src/admin/routes/*"],
            "@adminLayouts/*": ["./src/admin/layouts/*"],
            "@adminPages/*": ["./src/admin/pages/*"],
            "@adminStore/*": ["./src/admin/store/*"],
            "@adminApi/*": ["./src/admin/api/*"],
            "@adminConstants/*": ["./src/admin/constants/*"]
        }
    },
    "include": ["src"]
}
