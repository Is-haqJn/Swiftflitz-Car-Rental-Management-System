VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_BASE_URL=https://api.example.com
VITE_DEBUG_MODE=true
VITE_MAX_RETRY_ATTEMPTS=5
VITE_TIMEOUT_SECONDS=30
VITE_PERSIST_KEY=your_persistence_key_here
VITE_API_TIMEOUT_SECONDS=30
VITE_TOKEN_KEY=auth_token

VITE_AUTH_MODE=token # cookie or token

# WebSockets - set VITE_REVERB_BROADCASTER to "reverb" or "pusher"
# Reverb (self-hosted):
# VITE_REVERB_BROADCASTER=reverb
# VITE_REVERB_APP_KEY=your_reverb_app_key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http

# Pusher (cloud):
VITE_REVERB_BROADCASTER=pusher
VITE_REVERB_APP_KEY=your_pusher_app_key
VITE_REVERB_HOST=ws-us2.pusher.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_PUSHER_APP_CLUSTER=us2


VITE_SITE_URL=https://frontend.example.com
VITE_OG_IMAGE=/og-image.png