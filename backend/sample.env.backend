# ══════════════════════════════════════════════════════════════
# Laravel Reverb (WebSocket Server) Configuration
# ══════════════════════════════════════════════════════════════
#
# Reverb is a standalone WebSocket server that ships with Laravel.
# Run it with:  php artisan reverb:start
#
# IMPORTANT: REVERB_HOST is the interface Reverb *listens* on (server-side).
#   - Use 0.0.0.0  to accept connections on all interfaces (recommended).
#   - Use 127.0.0.1 to accept connections only from localhost.
#   - Do NOT set this to a full URL like http://example.com/api/v1
#
# REVERB_PORT is the WebSocket port Reverb listens on (default: 8080).
#   - Clients connect to this port, not port 80 or 443.
#   - If you're behind a reverse proxy (Nginx/Caddy), proxy WS to this port.
#
# BROADCAST_CONNECTION must be set to "reverb" to enable real-time events.
# ══════════════════════════════════════════════════════════════

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# These are passed to Vite for frontend use (usually same key as above)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
